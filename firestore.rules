rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.uid == "h8Dz1CPX4ghH3VLSr7XWZU0lvJC2"; }
    function validProductData() { return request.resource.data.keys().hasOnly(["name","category","price","stock","image","images","description","createdAt","updatedAt"]) && request.resource.data.name is string && request.resource.data.name.size()>0 && request.resource.data.name.size()<=120 && request.resource.data.category is string && request.resource.data.category.size()>0 && request.resource.data.category.size()<=60 && request.resource.data.price is number && request.resource.data.price>0 && request.resource.data.price<=10000000 && request.resource.data.stock is string && request.resource.data.stock in ["স্টকে আছে","সীমিত স্টক","স্টক নেই"] && request.resource.data.image is string && request.resource.data.image.size()<=2048 && request.resource.data.images is list && request.resource.data.images.size()<=6 && request.resource.data.description is string && request.resource.data.description.size()<=1000 && request.resource.data.updatedAt is timestamp; }
    function validNewProductData() { return validProductData() && request.resource.data.createdAt is timestamp; }
    match /products/{productId} { allow read: if true; allow create: if isAdmin() && validNewProductData(); allow update: if isAdmin() && validProductData(); allow delete: if isAdmin(); }
    function validCategoryData() { return request.resource.data.keys().hasOnly(["image"]) && request.resource.data.image is string && request.resource.data.image.size()>0 && request.resource.data.image.size()<=2048; }
    match /categories/{categoryId} { allow read: if true; allow create,update: if isAdmin() && validCategoryData(); allow delete: if isAdmin(); }
    function validSettings() { return request.resource.data.keys().hasOnly(["storeName","storeAddress","contactNumber","websiteUrl","whatsappNumber","currency","logoUrl","heroImages","bgType","bgColor","ownerDistrict","deliveryChargeInside","deliveryChargeOutside","deliveryTimeText","termsText","bkashNumber"]) && request.resource.data.storeName is string && request.resource.data.storeName.size()>0 && request.resource.data.storeName.size()<=120 && request.resource.data.storeAddress is string && request.resource.data.storeAddress.size()<=400 && request.resource.data.contactNumber is string && request.resource.data.contactNumber.size()<=30 && request.resource.data.websiteUrl is string && request.resource.data.websiteUrl.size()<=500 && request.resource.data.whatsappNumber is string && request.resource.data.whatsappNumber.size()<=30 && request.resource.data.currency is string && request.resource.data.currency.size()>0 && request.resource.data.currency.size()<=10 && request.resource.data.logoUrl is string && request.resource.data.logoUrl.size()<=2048 && request.resource.data.heroImages is list && request.resource.data.heroImages.size()<=6 && request.resource.data.bgType is string && request.resource.data.bgType.size()<=30 && request.resource.data.bgColor is string && request.resource.data.bgColor.size()<=20 && request.resource.data.ownerDistrict is string && request.resource.data.ownerDistrict.size()<=60 && request.resource.data.deliveryChargeInside is number && request.resource.data.deliveryChargeInside>=0 && request.resource.data.deliveryChargeOutside is number && request.resource.data.deliveryChargeOutside>=0 && request.resource.data.deliveryTimeText is string && request.resource.data.deliveryTimeText.size()<=200 && request.resource.data.termsText is string && request.resource.data.termsText.size()<=5000 && request.resource.data.bkashNumber is string && request.resource.data.bkashNumber.matches('^01[3-9][0-9]{8}$'); }
    match /settings/{docId} { allow read: if true; allow create,update: if isAdmin() && docId=="store_info" && validSettings(); allow delete: if false; }
    function validCustomerData() { return request.resource.data.keys().hasOnly(["phone","name","address","district","upazila","createdAt"]) && request.resource.data.phone is string && request.resource.data.phone.matches('^01[3-9][0-9]{8}$') && request.resource.data.name is string && request.resource.data.name.size()<=100 && request.resource.data.address is string && request.resource.data.address.size()<=400 && request.resource.data.district is string && request.resource.data.district.size()<=60 && request.resource.data.upazila is string && request.resource.data.upazila.size()<=60 && request.resource.data.createdAt is timestamp; }
    match /customers/{uid} { allow read: if request.auth!=null && (request.auth.uid==uid || isAdmin()); allow create: if request.auth!=null && request.auth.uid==uid && validCustomerData(); allow update: if request.auth!=null && request.auth.uid==uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name","address","district","upazila"]); allow delete: if false; }
    function validItems() { return request.resource.data.items is list && request.resource.data.items.size()>0 && request.resource.data.items.size()<=50; }
    function validSnapshot() { return request.resource.data.storeSnapshot is map && request.resource.data.storeSnapshot.keys().hasOnly(["storeName","storeAddress","contactNumber","websiteUrl","logoUrl","currency"]) && request.resource.data.storeSnapshot.storeName is string && request.resource.data.storeSnapshot.storeName.size()<=120 && request.resource.data.storeSnapshot.storeAddress is string && request.resource.data.storeSnapshot.storeAddress.size()<=400 && request.resource.data.storeSnapshot.contactNumber is string && request.resource.data.storeSnapshot.contactNumber.size()<=30 && request.resource.data.storeSnapshot.websiteUrl is string && request.resource.data.storeSnapshot.websiteUrl.size()<=500 && request.resource.data.storeSnapshot.logoUrl is string && request.resource.data.storeSnapshot.logoUrl.size()<=2048 && request.resource.data.storeSnapshot.currency is string && request.resource.data.storeSnapshot.currency.size()<=10; }
    function validNewOrder() { return request.resource.data.keys().hasOnly(["customerUid","customerName","customerPhone","customerUpazila","customerAddress","customerDistrict","items","itemsTotal","deliveryCharge","grandTotal","paymentMethod","paymentTrxId","paymentAmountEntered","storeSnapshot","status","trackingUrl","statusUpdatedAt","createdAt"]) && request.auth!=null && request.resource.data.customerUid==request.auth.uid && request.resource.data.customerName is string && request.resource.data.customerName.size()>0 && request.resource.data.customerName.size()<=100 && request.resource.data.customerPhone is string && request.resource.data.customerPhone.size()>=11 && request.resource.data.customerPhone.size()<=20 && request.resource.data.customerUpazila is string && request.resource.data.customerUpazila.size()<=60 && request.resource.data.customerAddress is string && request.resource.data.customerAddress.size()>0 && request.resource.data.customerAddress.size()<=400 && request.resource.data.customerDistrict is string && request.resource.data.customerDistrict.size()>0 && request.resource.data.customerDistrict.size()<=60 && validItems() && request.resource.data.itemsTotal is number && request.resource.data.itemsTotal>=0 && request.resource.data.deliveryCharge is number && request.resource.data.deliveryCharge>=0 && request.resource.data.grandTotal is number && request.resource.data.grandTotal>=0 && validSnapshot() && request.resource.data.paymentMethod is string && request.resource.data.paymentTrxId is string && request.resource.data.paymentTrxId.size()>0 && request.resource.data.paymentTrxId.size()<=60 && request.resource.data.paymentAmountEntered is number && request.resource.data.paymentAmountEntered>0 && request.resource.data.status=="pending_payment" && request.resource.data.trackingUrl is string && request.resource.data.trackingUrl.size()<=500 && request.resource.data.statusUpdatedAt is timestamp && request.resource.data.createdAt is timestamp; }
    function validOrderUpdate() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","trackingUrl","statusUpdatedAt"]) && request.resource.data.status is string && request.resource.data.status in ["pending_payment","confirmed","payment_mismatch","processing","shipped","delivered","cancelled"] && request.resource.data.trackingUrl is string && request.resource.data.trackingUrl.size()<=500 && request.resource.data.statusUpdatedAt is timestamp; }
    match /orders/{orderId} { allow get: if isAdmin() || (request.auth!=null && resource.data.customerUid==request.auth.uid); allow list: if isAdmin() || (request.auth!=null && resource.data.customerUid==request.auth.uid); allow create: if validNewOrder(); allow update: if isAdmin() && validOrderUpdate(); allow delete: if isAdmin(); }
    function validChatMeta() { return request.resource.data.keys().hasOnly(["customerName","customerPhone","lastMessage","lastMessageAt","unreadByAdmin","unreadByCustomer"]) && request.resource.data.customerName is string && request.resource.data.customerName.size()<=100 && request.resource.data.customerPhone is string && request.resource.data.customerPhone.size()<=20 && request.resource.data.lastMessage is string && request.resource.data.lastMessage.size()<=1000 && request.resource.data.lastMessageAt is timestamp && request.resource.data.unreadByAdmin is bool && request.resource.data.unreadByCustomer is bool; }
    match /chats/{uid} { allow read: if request.auth!=null && (request.auth.uid==uid || isAdmin()); allow write: if request.auth!=null && (request.auth.uid==uid || isAdmin()) && validChatMeta(); match /messages/{messageId} { function validMessage() { return request.resource.data.keys().hasOnly(["sender","text","createdAt"]) && request.resource.data.sender in ["customer","admin"] && (request.resource.data.sender=="admin" ? isAdmin() : request.auth.uid==uid) && request.resource.data.text is string && request.resource.data.text.size()>0 && request.resource.data.text.size()<=1000 && request.resource.data.createdAt is timestamp; } allow read: if request.auth!=null && (request.auth.uid==uid || isAdmin()); allow create: if request.auth!=null && (request.auth.uid==uid || isAdmin()) && validMessage(); allow update,delete: if false; } }
    match /{document=**} { allow read,write: if false; }
  }
}
